import <io>;
import <mem>;
import <fs>;
import <onnx>;
import "../src/viro_onnx.esk";

// detect MODEL INPUT.bin [CONF]: runs the core on a 1x3x640x640 NCHW input and prints
// one detection per line, in the format of tests/reference.py.

int main(int argc, string* argv) {
    if (argc < 3) {
        printf("usage: detect MODEL INPUT.bin [CONF]\n");
        return 2;
    }
    int64 n = 0;
    *float x = (*float)fs_read_all(argv[2], &n);
    if (x == null || n != 3 * 640 * 640 * 4) {
        printf("bad input %s\n", argv[2]);
        return 1;
    }
    defer free((*void)x);
    float conf = 0.25;
    if (argc > 3) conf = (float)atof(argv[3]);
    if (viro_onnx_load_file(argv[1], argv[1], VIRO_ONNX_CPU) != 1) {
        printf("%s\n", viro_onnx_last_error());
        return 1;
    }
    ViroDetection[64] d;
    int k = viro_onnx_detect(argv[1], x, 640, conf, &d[0], 64);
    if (k < 0) {
        printf("%s\n", viro_onnx_last_error());
        return 1;
    }
    for (i in 0..k) {
        printf("%.4f %.4f %.4f %.4f %.4f %d ", (double)d[i].x, (double)d[i].y, (double)d[i].width,
            (double)d[i].height, (double)d[i].confidence, d[i].class_index);
        if (d[i].label != null) printf("%s\n", d[i].label);
        else printf("%d\n", d[i].class_index);
    }
    // A second run after release_all reloads the session; the labels stay valid.
    viro_onnx_release_all();
    if (viro_onnx_is_loaded(argv[1]) != 0) return 1;
    if (viro_onnx_detect(argv[1], x, 640, conf, &d[0], 64) != -1) return 1;
    return 0;
}
