{
  "name": "@reactvision/react-viro-onnx",
  "version": "1.0.0",
  "description": "ONNX Runtime inference provider for @reactvision/react-viro ViroObjectDetector",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "plugin": "./plugin/build/withViroONNX.js",
  "expo": {
    "install": {
      "exclude": []
    }
  },
  "scripts": {
    "setup": "bash scripts/download_onnxruntime.sh",
    "build": "tsc && npm run build:plugin",
    "build:plugin": "tsc -p plugin/tsconfig.json"
  },
  "keywords": [
    "react-native",
    "ar",
    "viro",
    "onnx",
    "yoloe",
    "object-detection",
    "expo-plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@reactvision/react-viro": ">=2.56.0",
    "react-native": ">=0.81.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
